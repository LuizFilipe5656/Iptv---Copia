import 'package:flutter/material.dart';

import 'cinemeta_catalog_screen.dart';
import 'addon_category_screen.dart';
import '../repositories/addon_repository.dart';
import '../repositories/catalog_repository.dart';
import '../repositories/stream_repository.dart';
import '../services/playback_progress_service.dart';

class SeriesScreen extends StatelessWidget {
  const SeriesScreen({
    super.key,
    this.addonRepository,
    this.catalogRepository,
    this.streamRepository,
    this.playbackProgressService,
  });

  final AddonRepository? addonRepository;
  final CatalogRepository? catalogRepository;
  final StreamRepository? streamRepository;
  final PlaybackProgressService? playbackProgressService;

  static const routeName = '/series';

  @override
  Widget build(BuildContext context) {
    return DefaultTabController(
      length: 3,
      child: Scaffold(
        appBar: AppBar(
          title: const Text('Séries'),
          bottom: const TabBar(
            tabs: [
              Tab(text: 'Séries'),
              Tab(text: 'Doramas'),
              Tab(text: 'Desenhos'),
            ],
          ),
        ),
        body: TabBarView(
          children: [
            CinemetaCatalogScreen(
              title: 'Séries',
              showAppBar: false,
              loadCatalog: (service) => service.popularSeries(),
              addonRepository: addonRepository,
              catalogRepository: catalogRepository,
              streamRepository: streamRepository,
              playbackProgressService: playbackProgressService,
            ),
            AddonCategoryScreen(
              category: AddonCategory.doramas,
              addonRepository: addonRepository,
              catalogRepository: catalogRepository,
              streamRepository: streamRepository,
            ),
            AddonCategoryScreen(
              category: AddonCategory.cartoons,
              addonRepository: addonRepository,
              catalogRepository: catalogRepository,
              streamRepository: streamRepository,
            ),
          ],
        ),
      ),
    );
  }
}
